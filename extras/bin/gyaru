#!/usr/bin/env bash
# Start on-demand ollama (not a boot service) and talk to gyaru.
set -euo pipefail
systemctl --user start ollama.service 2>/dev/null || true
ok=0
for _ in $(seq 1 40); do
  if curl -fsS --max-time 1 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 0.25
done
[[ "$ok" -eq 1 ]] || { echo "ollama did not come up — systemctl --user start ollama" >&2; exit 1; }
exec ollama run gyaru
