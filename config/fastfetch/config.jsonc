{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Nazuna (Call of the Night), cropped to face/hair from the original
  // wallpaper at ~/Pictures/unsorted/1249331.jpg -- crop lives at
  // ~/.config/fastfetch/images/nazuna-face.png. kitty logo type uses
  // kitty's own image protocol, sharpest option since this only ever runs
  // inside kitty.
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/images/nazuna-face.png",
    "width": 30,
    "height": 15
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
