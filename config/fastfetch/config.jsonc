{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Placeholder logo for now -- swap "source" for the picture you actually
  // want (drop it in ~/Pictures/ and update the path here). kitty logo type
  // uses kitty's own image protocol, sharpest option since this only ever
  // runs inside kitty.
  "logo": {
    "type": "kitty",
    "source": "~/Pictures/unsorted/13253911.png",
    "width": 30,
    "height": 15
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "break",
    "colors"
  ]
}
