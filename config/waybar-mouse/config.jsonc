// Mouse-driven nav bar. Drop-in TOP-BAR REPLACEMENT, not an addition --
// toggle-mouse-nav.sh kills the normal ~/.config/waybar/config.jsonc
// process and starts this one in its place (same layer/position/height),
// then swaps back on the next SUPER+SHIFT+M. Independent of the look-swap
// system -- not tied to any look.
//
// Workspace switching is NOT the native hyprland/workspaces module -- this
// Hyprland build's dispatch IPC is Lua-expression-only now, and stock
// waybar's built-in workspace click still speaks the old classic syntax,
// so it silently does nothing (confirmed live). Fixed custom/ws1..ws9
// buttons calling ws-jump.sh (correct syntax) replace it, matching the
// 1-9 range hyprland.lua's own SUPER+<n> keybinds already use.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 3,

  "modules-left": ["custom/mouse-toggle", "wireplumber"],
  "modules-center": [
    "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
    "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9",
    "custom/add-workspace",
    "custom/sep-left",
    "wlr/taskbar",
    "custom/sep-right",
    "custom/launcher", "custom/keyboard"
  ],
  "modules-right": ["clock", "custom/power"],

  // toggles back to the normal bar (same script as SUPER+SHIFT+M and the
  // normal bar's own mouse-toggle button -- it detects which bar is
  // running and switches to the other one either way).
  "custom/mouse-toggle": {
    "format": "",
    "on-click": "$HOME/.config/scripts/toggle-mouse-nav.sh",
    "tooltip": "Back to normal bar"
  },

  "wireplumber": {
    "format": "vol {volume}",
    "format-muted": "muted"
  },

  "clock": {
    "format": "{:%a %d-%m-%Y  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  // one module per workspace, polled 1/sec for which one is active
  // (ws-state.sh). "class": "wsbtn" is the static base class; the JSON
  // output's own "class" adds "active" on top of it when current.
  "custom/ws1": { "exec": "$HOME/.config/scripts/ws-state.sh 1", "on-click": "$HOME/.config/scripts/ws-jump.sh 1", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws2": { "exec": "$HOME/.config/scripts/ws-state.sh 2", "on-click": "$HOME/.config/scripts/ws-jump.sh 2", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws3": { "exec": "$HOME/.config/scripts/ws-state.sh 3", "on-click": "$HOME/.config/scripts/ws-jump.sh 3", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws4": { "exec": "$HOME/.config/scripts/ws-state.sh 4", "on-click": "$HOME/.config/scripts/ws-jump.sh 4", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws5": { "exec": "$HOME/.config/scripts/ws-state.sh 5", "on-click": "$HOME/.config/scripts/ws-jump.sh 5", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws6": { "exec": "$HOME/.config/scripts/ws-state.sh 6", "on-click": "$HOME/.config/scripts/ws-jump.sh 6", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws7": { "exec": "$HOME/.config/scripts/ws-state.sh 7", "on-click": "$HOME/.config/scripts/ws-jump.sh 7", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws8": { "exec": "$HOME/.config/scripts/ws-state.sh 8", "on-click": "$HOME/.config/scripts/ws-jump.sh 8", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },
  "custom/ws9": { "exec": "$HOME/.config/scripts/ws-state.sh 9", "on-click": "$HOME/.config/scripts/ws-jump.sh 9", "interval": 1, "return-type": "json", "class": "wsbtn", "tooltip": false },

  // jumps to the first free workspace id above the highest one that exists
  "custom/add-workspace": {
    "format": "+",
    "on-click": "$HOME/.config/scripts/add-workspace.sh",
    "class": "wsbtn",
    "tooltip": false
  },

  // plain vertical-bar separators -- workspaces | open apps | tools
  "custom/sep-left":  { "exec": "echo '│'", "interval": 0, "class": "sep", "tooltip": false },
  "custom/sep-right": { "exec": "echo '│'", "interval": 0, "class": "sep", "tooltip": false },

  // open windows, click to focus, middle-click to close, wheel to cycle
  // (taskbar-cycle.sh -- wlr-foreign-toplevel-management protocol, not
  // Hyprland's dispatch IPC, so activate/close aren't affected by the
  // dispatch-syntax issue above; only the wheel-scroll action goes through
  // our own hyprctl call and needed the same Lua-syntax fix).
  "wlr/taskbar": {
    "format": "{name}",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-scroll-up": "$HOME/.config/scripts/taskbar-cycle.sh next",
    "on-scroll-down": "$HOME/.config/scripts/taskbar-cycle.sh prev",
    "all-outputs": true
  },

  "custom/launcher": {
    "format": "apps",
    "on-click": "fuzzel",
    "class": "toolbtn",
    "tooltip": false
  },

  "custom/keyboard": {
    "format": "kbd",
    "on-click": "$HOME/.config/scripts/toggle-wvkbd.sh",
    "class": "toolbtn",
    "tooltip": false
  },

  // icon only, not a word -- Lock/Restart/Shutdown (power-confirm-menu.sh).
  // Same script the default bar's power icon uses (see ~/.config/waybar).
  "custom/power": {
    "format": "",
    "on-click": "$HOME/.config/scripts/power-confirm-menu.sh",
    "class": "powerbtn",
    "tooltip": "Power menu"
  }
}
